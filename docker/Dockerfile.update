FROM ghcr.io/tongyi-mai/mobile_world:v1

# Install socat (added after initial release for ADB port relay)
RUN apt-get update && apt-get install -y --no-install-recommends socat && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# aiohttp for the web-scrcpy WebSocket<->ADB proxy (ws_adb_proxy.py).
# Old VNC stack (xvfb/x11vnc/openbox/novnc/websockify) is left installed but
# unused — entrypoint.sh no longer launches it. This avoids a full base-image
# rebuild; if/when we cut a new base image we can drop those packages there.
RUN pip install --break-system-packages --no-cache aiohttp

# Switch to iptables-nft backend for compatibility with host kernels (6.x+)
# that have dropped the legacy iptable_nat module in favor of nftables-only NAT.
# The entrypoint also does runtime detection and can fall back to legacy if needed.
RUN update-alternatives --set iptables /usr/sbin/iptables-nft && \
    update-alternatives --set ip6tables /usr/sbin/ip6tables-nft

# Copy updated source code (carries the --viewer / ENABLE_VIEWER plumbing)
COPY src/ /app/service/src/

# web-scrcpy viewer: vendored panda-web-scrcpy frontend (Apache 2.0) +
# WebSocket-to-ADB proxy. Replaces the old VNC viewer and the Python
# `mobile-world viewer` Gradio app — single ~120-line aiohttp process now
# serves both the static UI and the scrcpy stream.
COPY docker/web-scrcpy /app/web-scrcpy
COPY docker/ws_adb_proxy.py /app/docker/ws_adb_proxy.py
RUN chmod +x /app/docker/ws_adb_proxy.py

# Copy updated entrypoint (web-scrcpy launch + iptables auto-detection
# + dockerd health check + outbound HTTP proxy normalization)
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Copy updated emulator launch script (Android system-proxy plumbing)
COPY docker/start_emulator.sh /app/docker/start_emulator.sh
RUN chmod +x /app/docker/start_emulator.sh

# Copy the in-container proxy chain that handles 10.0.2.x bypass
COPY docker/proxy_chain.py /app/docker/proxy_chain.py
RUN chmod +x /app/docker/proxy_chain.py

# Update CMD to also tail dockerd log
CMD tail -f /var/log/emulator.log /var/log/server.log /var/log/dockerd.err.log
